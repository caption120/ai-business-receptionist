PORT=5000
MONGODB_URI=your_mongodb_connection_string
GOOGLE_API_KEY=your_gemini_or_google_api_key
GEMINI_API_KEY=your_gemini_api_key_optional_fallback

# AWS Credentials (if using S3 for PDF storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_BUCKET_NAME=your_aws_bucket_name

# Pinecone configuration (if using Pinecone instead of ChromaDB)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=your_pinecone_index

# Google Calendar configuration
GOOGOLE_CLANDER_API=your_google_calendar_api_key
GOOGLE_CALENDAR_ID=your_google_calendar_id
GOOGLE_APPLICATION_CREDENTIALS=./src/credentials/service-account.json

# CORS Allowed Origin for production
FRONTEND_URL=your_vercel_frontend_url
